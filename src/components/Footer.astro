---
const currentYear = new Date().getFullYear();
const categories = [
  { label: 'Loan Calculator', href: '/tools/loan-calculator' },
  { label: 'BMI Calculator', href: '/tools/bmi-calculator' },
  { label: 'Compound Interest', href: '/tools/compound-interest' },
  { label: 'Percentage Calculator', href: '/tools/percentage-calculator' },
  { label: 'Unit Converter', href: '/tools/unit-converter' },
  { label: 'Age Calculator', href: '/tools/age-calculator' },
  { label: 'Tip Calculator', href: '/tools/tip-calculator' },
  { label: 'Discount Calculator', href: '/tools/discount-calculator' },
];
---

<footer class="bg-gray-900 text-gray-400 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2.5 mb-4">
          <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="4" y="2" width="16" height="20" rx="2"/>
              <line x1="8" y1="6" x2="16" y2="6"/>
            </svg>
          </div>
          <span class="text-lg font-bold text-white">CalcBox</span>
        </div>
        <p class="text-sm leading-relaxed">Free online calculators and conversion tools. Fast, accurate, and no sign-up required.</p>
      </div>

      <!-- Tools -->
      <div>
        <h3 class="text-white font-semibold mb-4">Tools</h3>
        <ul class="space-y-2">
          {categories.slice(0, 4).map(item => (
            <li><a href={item.href} class="text-sm hover:text-indigo-400 transition">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- More Tools -->
      <div>
        <h3 class="text-white font-semibold mb-4">More Tools</h3>
        <ul class="space-y-2">
          {categories.slice(4).map(item => (
            <li><a href={item.href} class="text-sm hover:text-indigo-400 transition">{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-10 pt-6 text-sm text-center">
      <p>&copy; {currentYear} CalcBox. All rights reserved.</p>
    </div>
  </div>
</footer>
