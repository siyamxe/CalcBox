---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Unit Converter" description="Convert between units of length, weight, temperature, area, volume, speed, and more.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-indigo-600 transition">Home</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Unit Converter</span>
    </nav>

    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-teal-100 rounded-2xl text-3xl mb-4">📐</div>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">Unit Converter</h1>
      <p class="text-gray-500 max-w-xl mx-auto">Instantly convert between common units of measurement.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
      <!-- Category Tabs -->
      <div class="flex flex-wrap gap-2 mb-6">
        <button data-cat="length" class="cat-btn px-4 py-2 text-sm font-semibold rounded-lg bg-indigo-100 text-indigo-700">📏 Length</button>
        <button data-cat="weight" class="cat-btn px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200">⚖️ Weight</button>
        <button data-cat="temperature" class="cat-btn px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200">🌡️ Temp</button>
        <button data-cat="area" class="cat-btn px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200">📐 Area</button>
        <button data-cat="speed" class="cat-btn px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200">🏎️ Speed</button>
        <button data-cat="volume" class="cat-btn px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200">🧪 Volume</button>
      </div>

      <!-- Converter -->
      <div class="grid grid-cols-1 sm:grid-cols-[1fr,auto,1fr] gap-4 items-end">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">From</label>
          <input id="from-val" type="number" value="1" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-lg mb-2" />
          <select id="from-unit" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-white"></select>
        </div>

        <button id="swap-btn" class="self-center p-3 hover:bg-gray-100 rounded-xl transition mx-auto" title="Swap units">
          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        </button>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">To</label>
          <input id="to-val" type="text" readonly class="w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50 text-lg mb-2 font-semibold text-indigo-700 outline-none" />
          <select id="to-unit" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-white"></select>
        </div>
      </div>

      <!-- Formula -->
      <div id="formula" class="mt-6 p-4 bg-gray-50 rounded-xl text-sm text-gray-600 text-center"></div>
    </div>
  </div>
</Layout>

<script>
  type UnitDef = { label: string; toBase: (v: number) => number; fromBase: (v: number) => number };
  type UnitMap = Record<string, UnitDef>;

  const units: Record<string, UnitMap> = {
    length: {
      m: { label: 'Meters', toBase: v => v, fromBase: v => v },
      km: { label: 'Kilometers', toBase: v => v * 1000, fromBase: v => v / 1000 },
      cm: { label: 'Centimeters', toBase: v => v / 100, fromBase: v => v * 100 },
      mm: { label: 'Millimeters', toBase: v => v / 1000, fromBase: v => v * 1000 },
      mi: { label: 'Miles', toBase: v => v * 1609.344, fromBase: v => v / 1609.344 },
      ft: { label: 'Feet', toBase: v => v * 0.3048, fromBase: v => v / 0.3048 },
      in: { label: 'Inches', toBase: v => v * 0.0254, fromBase: v => v / 0.0254 },
      yd: { label: 'Yards', toBase: v => v * 0.9144, fromBase: v => v / 0.9144 },
    },
    weight: {
      kg: { label: 'Kilograms', toBase: v => v, fromBase: v => v },
      g: { label: 'Grams', toBase: v => v / 1000, fromBase: v => v * 1000 },
      mg: { label: 'Milligrams', toBase: v => v / 1e6, fromBase: v => v * 1e6 },
      lb: { label: 'Pounds', toBase: v => v * 0.453592, fromBase: v => v / 0.453592 },
      oz: { label: 'Ounces', toBase: v => v * 0.0283495, fromBase: v => v / 0.0283495 },
      t: { label: 'Metric Tons', toBase: v => v * 1000, fromBase: v => v / 1000 },
    },
    temperature: {
      c: { label: 'Celsius', toBase: v => v, fromBase: v => v },
      f: { label: 'Fahrenheit', toBase: v => (v - 32) * 5/9, fromBase: v => v * 9/5 + 32 },
      k: { label: 'Kelvin', toBase: v => v - 273.15, fromBase: v => v + 273.15 },
    },
    area: {
      m2: { label: 'Square Meters', toBase: v => v, fromBase: v => v },
      km2: { label: 'Square Km', toBase: v => v * 1e6, fromBase: v => v / 1e6 },
      ft2: { label: 'Square Feet', toBase: v => v * 0.092903, fromBase: v => v / 0.092903 },
      ac: { label: 'Acres', toBase: v => v * 4046.86, fromBase: v => v / 4046.86 },
      ha: { label: 'Hectares', toBase: v => v * 10000, fromBase: v => v / 10000 },
    },
    speed: {
      ms: { label: 'm/s', toBase: v => v, fromBase: v => v },
      kmh: { label: 'km/h', toBase: v => v / 3.6, fromBase: v => v * 3.6 },
      mph: { label: 'mph', toBase: v => v * 0.44704, fromBase: v => v / 0.44704 },
      kn: { label: 'Knots', toBase: v => v * 0.514444, fromBase: v => v / 0.514444 },
    },
    volume: {
      l: { label: 'Liters', toBase: v => v, fromBase: v => v },
      ml: { label: 'Milliliters', toBase: v => v / 1000, fromBase: v => v * 1000 },
      gal: { label: 'Gallons (US)', toBase: v => v * 3.78541, fromBase: v => v / 3.78541 },
      qt: { label: 'Quarts', toBase: v => v * 0.946353, fromBase: v => v / 0.946353 },
      cup: { label: 'Cups (US)', toBase: v => v * 0.236588, fromBase: v => v / 0.236588 },
      floz: { label: 'Fluid Oz', toBase: v => v * 0.0295735, fromBase: v => v / 0.0295735 },
    },
  };

  let currentCat = 'length';
  const fromVal = document.getElementById('from-val') as HTMLInputElement;
  const fromUnit = document.getElementById('from-unit') as HTMLSelectElement;
  const toVal = document.getElementById('to-val') as HTMLInputElement;
  const toUnit = document.getElementById('to-unit') as HTMLSelectElement;
  const formula = document.getElementById('formula')!;

  function populateSelects() {
    const u = units[currentCat];
    const keys = Object.keys(u);
    [fromUnit, toUnit].forEach((sel, i) => {
      sel.innerHTML = keys.map(k => `<option value="${k}" ${i === 1 && k === keys[1] ? 'selected' : ''}>${u[k].label}</option>`).join('');
    });
    if (keys.length > 1) toUnit.value = keys[1];
    convert();
  }

  function convert() {
    const u = units[currentCat];
    const v = parseFloat(fromVal.value) || 0;
    const from = fromUnit.value;
    const to = toUnit.value;
    const base = u[from].toBase(v);
    const result = u[to].fromBase(base);
    toVal.value = result.toLocaleString('en-US', { maximumFractionDigits: 6 });
    formula.textContent = `${v} ${u[from].label} = ${toVal.value} ${u[to].label}`;
  }

  // Category tabs
  document.querySelectorAll('.cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      currentCat = (btn as HTMLElement).dataset.cat || 'length';
      document.querySelectorAll('.cat-btn').forEach(b => {
        b.className = 'cat-btn px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200';
      });
      btn.className = 'cat-btn px-4 py-2 text-sm font-semibold rounded-lg bg-indigo-100 text-indigo-700';
      populateSelects();
    });
  });

  fromVal.addEventListener('input', convert);
  fromUnit.addEventListener('change', convert);
  toUnit.addEventListener('change', convert);

  document.getElementById('swap-btn')?.addEventListener('click', () => {
    const tmpUnit = fromUnit.value;
    fromUnit.value = toUnit.value;
    toUnit.value = tmpUnit;
    convert();
  });

  populateSelects();
</script>
