---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Discount Calculator" description="Calculate the final price after applying any discount percentage. Find out how much you save.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-indigo-600 transition">Home</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Discount Calculator</span>
    </nav>

    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-rose-100 rounded-2xl text-3xl mb-4">🏷️</div>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">Discount Calculator</h1>
      <p class="text-gray-500 max-w-xl mx-auto">Find the final price and total savings after a discount.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 max-w-lg mx-auto">
      <div class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Original Price</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">$</span>
            <input id="price" type="number" value="120" min="0" step="0.01" class="w-full pl-8 pr-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-lg" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-3">Discount</label>
          <div class="flex gap-2 flex-wrap mb-3">
            <button class="disc-preset px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-rose-100 hover:text-rose-700 transition" data-disc="10">10%</button>
            <button class="disc-preset px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-rose-100 hover:text-rose-700 transition" data-disc="15">15%</button>
            <button class="disc-preset px-4 py-2 text-sm font-semibold rounded-lg bg-rose-100 text-rose-700" data-disc="20">20%</button>
            <button class="disc-preset px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-rose-100 hover:text-rose-700 transition" data-disc="25">25%</button>
            <button class="disc-preset px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-rose-100 hover:text-rose-700 transition" data-disc="50">50%</button>
            <button class="disc-preset px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-rose-100 hover:text-rose-700 transition" data-disc="75">75%</button>
          </div>
          <div class="relative">
            <input id="discount" type="number" value="20" min="0" max="100" step="1" class="w-full pl-4 pr-10 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-lg" />
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400">%</span>
          </div>
        </div>
      </div>

      <!-- Results -->
      <div class="mt-8 space-y-4">
        <div class="bg-emerald-50 rounded-xl p-6 text-center">
          <div class="text-sm text-emerald-600 font-medium mb-1">Final Price</div>
          <div id="final-price" class="text-4xl font-bold text-emerald-700"></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-rose-50 rounded-xl p-4 text-center">
            <div class="text-xs text-rose-600 font-medium mb-1">You Save</div>
            <div id="savings" class="text-xl font-bold text-rose-700"></div>
          </div>
          <div class="bg-gray-50 rounded-xl p-4 text-center">
            <div class="text-xs text-gray-500 font-medium mb-1">Original</div>
            <div id="original-display" class="text-xl font-bold text-gray-400 line-through"></div>
          </div>
        </div>

        <!-- Visual -->
        <div class="mt-2">
          <div class="flex rounded-full overflow-hidden h-3">
            <div id="bar-pay" class="bg-emerald-400 transition-all duration-500"></div>
            <div id="bar-save" class="bg-rose-300 transition-all duration-500"></div>
          </div>
          <div class="flex justify-between mt-2 text-xs text-gray-500">
            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 bg-emerald-400 rounded-full inline-block"></span> You pay</span>
            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 bg-rose-300 rounded-full inline-block"></span> You save</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const fmt = (n: number) => '$' + n.toFixed(2);
  const price = document.getElementById('price') as HTMLInputElement;
  const discount = document.getElementById('discount') as HTMLInputElement;

  function calculate() {
    const p = parseFloat(price.value) || 0;
    const d = Math.min(parseFloat(discount.value) || 0, 100);
    const savings = p * (d / 100);
    const final_ = p - savings;

    document.getElementById('final-price')!.textContent = fmt(final_);
    document.getElementById('savings')!.textContent = fmt(savings);
    document.getElementById('original-display')!.textContent = fmt(p);

    const payPct = p > 0 ? (final_ / p) * 100 : 100;
    (document.getElementById('bar-pay') as HTMLElement).style.width = payPct + '%';
    (document.getElementById('bar-save') as HTMLElement).style.width = (100 - payPct) + '%';
  }

  price.addEventListener('input', calculate);
  discount.addEventListener('input', calculate);

  document.querySelectorAll('.disc-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      discount.value = (btn as HTMLElement).dataset.disc || '20';
      document.querySelectorAll('.disc-preset').forEach(b => {
        b.className = 'disc-preset px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-rose-100 hover:text-rose-700 transition';
      });
      btn.className = 'disc-preset px-4 py-2 text-sm font-semibold rounded-lg bg-rose-100 text-rose-700';
      calculate();
    });
  });

  calculate();
</script>
