---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Age Calculator" description="Find your exact age in years, months, and days. See your next birthday countdown.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-indigo-600 transition">Home</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Age Calculator</span>
    </nav>

    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-purple-100 rounded-2xl text-3xl mb-4">🎂</div>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">Age Calculator</h1>
      <p class="text-gray-500 max-w-xl mx-auto">Find your exact age and countdown to your next birthday.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 max-w-lg mx-auto">
      <div class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Date of Birth</label>
          <input id="dob" type="date" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-lg" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">As of Date</label>
          <input id="as-of" type="date" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-lg" />
        </div>
        <button id="calc-btn" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-lg shadow-indigo-200 hover:shadow-indigo-300 transition-all">
          Calculate Age
        </button>
      </div>

      <!-- Results -->
      <div id="results" class="mt-8 hidden space-y-5">
        <div class="grid grid-cols-3 gap-3">
          <div class="bg-purple-50 rounded-xl p-4 text-center">
            <div id="res-years" class="text-3xl font-bold text-purple-700"></div>
            <div class="text-xs text-purple-500 font-medium mt-1">Years</div>
          </div>
          <div class="bg-indigo-50 rounded-xl p-4 text-center">
            <div id="res-months" class="text-3xl font-bold text-indigo-700"></div>
            <div class="text-xs text-indigo-500 font-medium mt-1">Months</div>
          </div>
          <div class="bg-blue-50 rounded-xl p-4 text-center">
            <div id="res-days" class="text-3xl font-bold text-blue-700"></div>
            <div class="text-xs text-blue-500 font-medium mt-1">Days</div>
          </div>
        </div>

        <div class="space-y-3">
          <div class="flex justify-between items-center p-3 bg-gray-50 rounded-xl">
            <span class="text-sm text-gray-600">Total months</span>
            <span id="total-months" class="font-semibold text-gray-900"></span>
          </div>
          <div class="flex justify-between items-center p-3 bg-gray-50 rounded-xl">
            <span class="text-sm text-gray-600">Total weeks</span>
            <span id="total-weeks" class="font-semibold text-gray-900"></span>
          </div>
          <div class="flex justify-between items-center p-3 bg-gray-50 rounded-xl">
            <span class="text-sm text-gray-600">Total days</span>
            <span id="total-days" class="font-semibold text-gray-900"></span>
          </div>
        </div>

        <!-- Next Birthday -->
        <div class="bg-amber-50 rounded-xl p-5 text-center">
          <div class="text-sm text-amber-700 font-medium mb-1">🎉 Next Birthday In</div>
          <div id="next-bday" class="text-xl font-bold text-amber-800"></div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Set default dates
  const now = new Date();
  const asOf = document.getElementById('as-of') as HTMLInputElement;
  asOf.value = now.toISOString().split('T')[0];

  function calculate() {
    const dob = new Date((document.getElementById('dob') as HTMLInputElement).value);
    const today = new Date((document.getElementById('as-of') as HTMLInputElement).value);

    if (isNaN(dob.getTime()) || isNaN(today.getTime()) || dob >= today) return;

    let years = today.getFullYear() - dob.getFullYear();
    let months = today.getMonth() - dob.getMonth();
    let days = today.getDate() - dob.getDate();

    if (days < 0) {
      months--;
      const prevMonth = new Date(today.getFullYear(), today.getMonth(), 0);
      days += prevMonth.getDate();
    }
    if (months < 0) {
      years--;
      months += 12;
    }

    document.getElementById('res-years')!.textContent = String(years);
    document.getElementById('res-months')!.textContent = String(months);
    document.getElementById('res-days')!.textContent = String(days);

    const diffMs = today.getTime() - dob.getTime();
    const totalDays = Math.floor(diffMs / 86400000);
    document.getElementById('total-months')!.textContent = (years * 12 + months).toLocaleString();
    document.getElementById('total-weeks')!.textContent = Math.floor(totalDays / 7).toLocaleString();
    document.getElementById('total-days')!.textContent = totalDays.toLocaleString();

    // Next birthday
    let nextBday = new Date(today.getFullYear(), dob.getMonth(), dob.getDate());
    if (nextBday <= today) nextBday = new Date(today.getFullYear() + 1, dob.getMonth(), dob.getDate());
    const daysUntil = Math.ceil((nextBday.getTime() - today.getTime()) / 86400000);
    document.getElementById('next-bday')!.textContent = daysUntil === 0 ? "🎂 It's today!" : `${daysUntil} day${daysUntil !== 1 ? 's' : ''}`;

    document.getElementById('results')!.classList.remove('hidden');
  }

  document.getElementById('calc-btn')?.addEventListener('click', calculate);
</script>
