---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Tip Calculator" description="Calculate tips and split bills among any group size with ease.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-indigo-600 transition">Home</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Tip Calculator</span>
    </nav>

    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-amber-100 rounded-2xl text-3xl mb-4">🧾</div>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">Tip Calculator</h1>
      <p class="text-gray-500 max-w-xl mx-auto">Quickly calculate tips and split bills among any number of people.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 max-w-lg mx-auto">
      <div class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Bill Amount</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">$</span>
            <input id="bill" type="number" value="85" min="0" step="0.01" class="w-full pl-8 pr-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-lg" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-3">Tip Percentage</label>
          <div class="flex gap-2 flex-wrap mb-3">
            <button class="tip-preset px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-indigo-100 hover:text-indigo-700 transition" data-tip="10">10%</button>
            <button class="tip-preset px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-indigo-100 hover:text-indigo-700 transition" data-tip="15">15%</button>
            <button class="tip-preset px-4 py-2 text-sm font-semibold rounded-lg bg-indigo-100 text-indigo-700" data-tip="18">18%</button>
            <button class="tip-preset px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-indigo-100 hover:text-indigo-700 transition" data-tip="20">20%</button>
            <button class="tip-preset px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-indigo-100 hover:text-indigo-700 transition" data-tip="25">25%</button>
          </div>
          <div class="relative">
            <input id="tip-pct" type="number" value="18" min="0" step="1" class="w-full pl-4 pr-10 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-lg" />
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400">%</span>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Number of People</label>
          <div class="flex items-center gap-4">
            <button id="ppl-minus" class="w-10 h-10 rounded-xl bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-xl font-bold text-gray-600 transition">−</button>
            <input id="people" type="number" value="2" min="1" class="w-20 px-3 py-3 border border-gray-200 rounded-xl text-center text-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none" />
            <button id="ppl-plus" class="w-10 h-10 rounded-xl bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-xl font-bold text-gray-600 transition">+</button>
          </div>
        </div>
      </div>

      <!-- Results -->
      <div class="mt-8 space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-indigo-50 rounded-xl p-5 text-center">
            <div class="text-sm text-indigo-600 font-medium mb-1">Tip Amount</div>
            <div id="tip-amount" class="text-2xl font-bold text-indigo-700"></div>
          </div>
          <div class="bg-emerald-50 rounded-xl p-5 text-center">
            <div class="text-sm text-emerald-600 font-medium mb-1">Total</div>
            <div id="total" class="text-2xl font-bold text-emerald-700"></div>
          </div>
        </div>
        <div class="bg-purple-50 rounded-xl p-5 text-center">
          <div class="text-sm text-purple-600 font-medium mb-1">Per Person</div>
          <div id="per-person" class="text-3xl font-bold text-purple-700"></div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const fmt = (n: number) => '$' + n.toFixed(2);
  const bill = document.getElementById('bill') as HTMLInputElement;
  const tipPct = document.getElementById('tip-pct') as HTMLInputElement;
  const people = document.getElementById('people') as HTMLInputElement;

  function calculate() {
    const b = parseFloat(bill.value) || 0;
    const t = parseFloat(tipPct.value) || 0;
    const p = Math.max(parseInt(people.value) || 1, 1);

    const tipAmt = b * (t / 100);
    const total = b + tipAmt;

    document.getElementById('tip-amount')!.textContent = fmt(tipAmt);
    document.getElementById('total')!.textContent = fmt(total);
    document.getElementById('per-person')!.textContent = fmt(total / p);
  }

  bill.addEventListener('input', calculate);
  tipPct.addEventListener('input', calculate);
  people.addEventListener('input', calculate);

  document.getElementById('ppl-minus')?.addEventListener('click', () => {
    const v = Math.max((parseInt(people.value) || 1) - 1, 1);
    people.value = String(v);
    calculate();
  });
  document.getElementById('ppl-plus')?.addEventListener('click', () => {
    people.value = String((parseInt(people.value) || 1) + 1);
    calculate();
  });

  // Presets
  document.querySelectorAll('.tip-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      tipPct.value = (btn as HTMLElement).dataset.tip || '18';
      document.querySelectorAll('.tip-preset').forEach(b => {
        b.className = 'tip-preset px-4 py-2 text-sm font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-indigo-100 hover:text-indigo-700 transition';
      });
      btn.className = 'tip-preset px-4 py-2 text-sm font-semibold rounded-lg bg-indigo-100 text-indigo-700';
      calculate();
    });
  });

  calculate();
</script>
