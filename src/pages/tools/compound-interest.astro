---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Compound Interest Calculator" description="Calculate how your investments grow over time with compound interest and regular contributions.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-indigo-600 transition">Home</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Compound Interest</span>
    </nav>

    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-indigo-100 rounded-2xl text-3xl mb-4">📈</div>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">Compound Interest Calculator</h1>
      <p class="text-gray-500 max-w-xl mx-auto">See how your money grows over time with the power of compound interest.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-6">Investment Details</h2>
        <div class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Initial Investment</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">$</span>
              <input id="principal" type="number" value="10000" min="0" class="w-full pl-8 pr-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-lg" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Monthly Contribution</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">$</span>
              <input id="monthly" type="number" value="500" min="0" class="w-full pl-8 pr-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-lg" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Annual Interest Rate (%)</label>
            <div class="relative">
              <input id="rate" type="number" value="8" min="0" step="0.1" class="w-full pl-4 pr-10 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-lg" />
              <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400">%</span>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Time Period (Years)</label>
            <input id="years" type="number" value="20" min="1" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-lg" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Compounding Frequency</label>
            <select id="frequency" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-lg bg-white">
              <option value="12" selected>Monthly</option>
              <option value="4">Quarterly</option>
              <option value="2">Semi-Annually</option>
              <option value="1">Annually</option>
            </select>
          </div>
          <button id="calc-btn" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-lg shadow-indigo-200 hover:shadow-indigo-300 transition-all">
            Calculate
          </button>
        </div>
      </div>

      <div id="results" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 hidden">
        <h2 class="text-lg font-semibold text-gray-900 mb-6">Results</h2>
        <div class="space-y-4">
          <div class="bg-indigo-50 rounded-xl p-5 text-center">
            <div class="text-sm text-indigo-600 font-medium mb-1">Future Value</div>
            <div id="future-value" class="text-3xl font-bold text-indigo-700"></div>
          </div>
          <div class="grid grid-cols-3 gap-3">
            <div class="bg-gray-50 rounded-xl p-4 text-center">
              <div class="text-xs text-gray-500 font-medium mb-1">Total Invested</div>
              <div id="total-invested" class="text-base font-bold text-gray-900"></div>
            </div>
            <div class="bg-gray-50 rounded-xl p-4 text-center">
              <div class="text-xs text-gray-500 font-medium mb-1">Interest Earned</div>
              <div id="interest-earned" class="text-base font-bold text-emerald-600"></div>
            </div>
            <div class="bg-gray-50 rounded-xl p-4 text-center">
              <div class="text-xs text-gray-500 font-medium mb-1">Interest %</div>
              <div id="interest-pct" class="text-base font-bold text-purple-600"></div>
            </div>
          </div>
          <!-- Bar Breakdown -->
          <div class="mt-4">
            <div class="text-sm font-medium text-gray-700 mb-2">Growth Breakdown</div>
            <div class="flex rounded-full overflow-hidden h-4">
              <div id="bar-init" class="bg-indigo-500 transition-all duration-500"></div>
              <div id="bar-contrib" class="bg-blue-400 transition-all duration-500"></div>
              <div id="bar-interest" class="bg-emerald-400 transition-all duration-500"></div>
            </div>
            <div class="flex justify-between mt-2 text-xs text-gray-500">
              <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 bg-indigo-500 rounded-full inline-block"></span> Initial</span>
              <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 bg-blue-400 rounded-full inline-block"></span> Contributions</span>
              <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 bg-emerald-400 rounded-full inline-block"></span> Interest</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const fmt = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });

  function calculate() {
    const P = parseFloat((document.getElementById('principal') as HTMLInputElement).value) || 0;
    const pmt = parseFloat((document.getElementById('monthly') as HTMLInputElement).value) || 0;
    const r = (parseFloat((document.getElementById('rate') as HTMLInputElement).value) || 0) / 100;
    const t = parseFloat((document.getElementById('years') as HTMLInputElement).value) || 0;
    const n = parseInt((document.getElementById('frequency') as HTMLSelectElement).value) || 12;

    if (t <= 0) return;

    const rn = r / n;
    const nt = n * t;

    // FV of initial principal
    const fvPrincipal = P * Math.pow(1 + rn, nt);
    // FV of monthly contributions (convert monthly to per-period)
    const pmtPerPeriod = pmt * (12 / n);
    let fvContrib = 0;
    if (rn > 0) {
      fvContrib = pmtPerPeriod * (Math.pow(1 + rn, nt) - 1) / rn;
    } else {
      fvContrib = pmtPerPeriod * nt;
    }

    const fv = fvPrincipal + fvContrib;
    const totalContrib = P + pmt * 12 * t;
    const interest = fv - totalContrib;

    document.getElementById('future-value')!.textContent = fmt(fv);
    document.getElementById('total-invested')!.textContent = fmt(totalContrib);
    document.getElementById('interest-earned')!.textContent = fmt(interest);
    document.getElementById('interest-pct')!.textContent = totalContrib > 0 ? (interest / totalContrib * 100).toFixed(1) + '%' : '0%';

    const initPct = (P / fv) * 100;
    const contribPct = ((pmt * 12 * t) / fv) * 100;
    const intPct = (interest / fv) * 100;
    (document.getElementById('bar-init') as HTMLElement).style.width = initPct + '%';
    (document.getElementById('bar-contrib') as HTMLElement).style.width = contribPct + '%';
    (document.getElementById('bar-interest') as HTMLElement).style.width = intPct + '%';

    document.getElementById('results')!.classList.remove('hidden');
  }

  document.getElementById('calc-btn')?.addEventListener('click', calculate);
  calculate();
</script>
